# ==============================================================================
# BidStream Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env.local` (NEVER commit .env.local to Git)
# 2. Fill in your actual values
# 3. Load variables before starting services:
#    macOS/Linux: `export $(cat .env.local | xargs)`
#    OR use an IDE environment variable configuration
# ==============================================================================

# --- Database Configuration ---
DB_USERNAME=admin
DB_PASSWORD=your_postgres_password_here
# Used by: identity-service, auction-service
# Example passwords: admin@1234 (change for production!)

# --- JWT Security ---
JWT_SECRET=your_256_bit_secret_key_here_minimum_32_characters_long
# Used by: identity-service, auction-service
# Generate with: openssl rand -base64 32

# --- Redis Configuration ---
REDIS_PASSWORD=
# Optional: Leave empty if Redis has no password (local dev)
# Production: Set a strong password in docker-compose.yml and here

# --- Email Service (Gmail SMTP) ---
GMAIL_USERNAME=your-email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
# How to get Gmail App Password:
# 1. Enable 2FA on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate a new app password for "Mail"

# --- OAuth2 Providers (Optional) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-secret
# Get from: https://console.cloud.google.com/apis/credentials

OKTA_CLIENT_ID=your-okta-client-id
OKTA_CLIENT_SECRET=your-okta-client-secret
OKTA_ISSUER_URI=https://dev-your-tenant.okta.com
# Get from: https://developer.okta.com/

# --- AI Services (Phase 2) ---
GEMINI_API_KEY=your_gemini_api_key
# Get from: https://makersuite.google.com/app/apikey

# --- Payment Gateway (Razorpay - Phase 7) ---
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Get from: https://dashboard.razorpay.com/app/keys

# ==============================================================================
# LOCAL DEVELOPMENT DEFAULTS (DO NOT USE IN PRODUCTION)
# ==============================================================================
# If you're just testing locally and don't need email/OAuth, you can skip
# setting those variables. The services will fall back to dummy values.
# However, DB_PASSWORD and JWT_SECRET are REQUIRED.
