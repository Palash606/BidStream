# ==============================================================================
# BidStream Auction Service - Configuration Template
# ==============================================================================
# This is a TEMPLATE file showing the structure of application.yml.
# The actual application.yml uses environment variables for all secrets.
# ==============================================================================

server:
  port: 8082

spring:
  application:
    name: auction-service

  datasource:
    url: jdbc:postgresql://localhost:5432/auction_db
    username: ${DB_USERNAME:admin}
    password: ${DB_PASSWORD}  # REQUIRED: Set in .env.local
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
        jdbc.time_zone: UTC

  mail:
    host: smtp.gmail.com
    port: 587
    username: ${GMAIL_USERNAME}  # REQUIRED: Your Gmail address
    password: ${GMAIL_APP_PASSWORD}  # REQUIRED: Gmail app password
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true

  data:
    redis:
      host: localhost
      port: 6379
      password: ${REDIS_PASSWORD:}  # Optional for local dev

  jackson:
    serialization:
      fail-on-empty-beans: false

  thymeleaf:
    cache: false
    prefix: classpath:/templates/
    suffix: .html

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/

jwt:
  secret: ${JWT_SECRET}  # REQUIRED: Must match identity-service secret
  expiration: 3600000  # 1 hour

# Business Logic Settings
auction:
  max-payment-attempts: 3
  lockout-hours: 12
  payment-base-url: "http://localhost:3000/pay/"
